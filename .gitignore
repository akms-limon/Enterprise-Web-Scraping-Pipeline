cat > .gitignore <<'EOF'
# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/

# Environment variables and secrets
.env
.env.*
!.env.example

# Test and coverage
.pytest_cache/
.coverage
htmlcov/

# Type checking and linting
.mypy_cache/
.ruff_cache/

# Scrapy output
books.json
books.csv
books.xml
output/
logs/

# SQLite databases
*.db
*.sqlite
*.sqlite3

# Editor and OS files
.vscode/
.idea/
.DS_Store
EOF